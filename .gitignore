# Secrets — never commit. api_keys.json holds the live Gemini key; certs/ holds
# the dashboard's TLS private key. Both are generated locally by setup.py.
.env
config/api_keys.json
config/certs/

# Python bytecode — regenerated on every run
__pycache__/
*.py[cod]

# Runtime state, not source. orchestrator.db is rebuilt from state/schema.sql.
state/orchestrator.db
state/orchestrator.db-journal
state/orchestrator.db-wal

# Personal runtime memory — regenerated by the app, and it accumulates private
# details (identity, relationships, notes) that should never reach a remote.
# memory_manager.load_memory() recreates long_term.json when absent.
memory/long_term.json
vault/wiki/mark_l_memory.md
vault/outputs/task_summaries/

# Local artifacts
*.log
.venv/
venv/
